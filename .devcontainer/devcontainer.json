{
	"name": "hm-typst-template",
	"image": "mcr.microsoft.com/devcontainers/rust:2-1-trixie",
	"features": {
	    "ghcr.io/michidk/devcontainers-features/typst:1": {},
		"ghcr.io/lee-orr/rusty-dev-containers/cargo-binstall:0": {
			"packages": [
				"prek",
				"utpm",
				"tytanic"
			]
		},
		"ghcr.io/devcontainers/features/git-lfs:1": {}
	},
	"runArgs": [
		"--env-file",
		"${localWorkspaceFolder}/.devcontainer/.env"
	],
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"postAttachCommand": "git config --global --unset http.sslcainfo || true",
	"customizations": {
		"vscode": {
			"extensions": [
				"tomoki1207.pdf"
			]
		}
	}
}
